#!name = linux.sb 自动签到
#!desc = 仅在签到页按需抓取 Cookie（可用则不抓），每日定时自动签到。
#!author = Walvez & Minis
#!tag = 签到
#!icon = https://linux.sb/app/assets/index.svg

[Script]
# 只拦截签到页请求；Cookie 可用性由脚本内部判断，可用则不写入
http-request ^https:\/\/linux\.sb\/daily_checkin script-path=https://raw.githubusercontent.com/spaoye/sb--loon/main/linuxsb_cookie.js, requires-body=false, timeout=10, tag=linux.sb 抓取Cookie

# 每天 9:05 自动签到，失败时会标记 Cookie 需刷新
cron "5 9 * * *" script-path=https://raw.githubusercontent.com/spaoye/sb--loon/main/linuxsb_checkin.js, timeout=30, tag=linux.sb 定时签到

[Mitm]
hostname = linux.sb
