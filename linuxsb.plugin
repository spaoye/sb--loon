#!name = linux.sb 自动签到
#!desc = 访问 linux.sb 自动抓取 Cookie，每日定时自动签到。
#!author = Walvez & Minis
#!tag = 签到

[Script]
http-request ^https:\/\/linux\.sb\/ script-path=https://raw.githubusercontent.com/spaoye/loon-linuxsb-checkin/main/linuxsb_cookie.js, requires-body=false, tag=linux.sb 获取Cookie

cron "0 9 * * *" script-path=https://raw.githubusercontent.com/spaoye/loon-linuxsb-checkin/main/linuxsb_checkin.js, tag=linux.sb 定时签到

[Mitm]
hostname = linux.sb
