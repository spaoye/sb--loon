#!name = linux.sb 自动签到
#!desc = 访问 linux.sb 自动抓取 Cookie，每日定时自动签到。
#!author = Walvez & Minis
#!tag = 签到

[Script]
# 精准匹配主站页面请求
http-request ^https:\/\/linux\.sb\/(daily_checkin|topic|login|$|\?) script-path=https://fastly.jsdelivr.net/gh/spaoye/sb--loon@main/linuxsb_cookie.js, requires-body=false, tag=linux.sb 获取Cookie

cron "0 9 * * *" script-path=https://fastly.jsdelivr.net/gh/spaoye/sb--loon@main/linuxsb_checkin.js, tag=linux.sb 定时签到

[Mitm]
hostname = linux.sb
