#!name = linux.sb 自动签到
#!desc = 访问 linux.sb 自动抓取 Cookie，每日定时自动签到。
#!author = Walvez & Minis
#!tag = 签到

[Script]
# 拦截请求获取 Cookie
http-request ^https?:\/\/(www\.)?linux\.(sb|bi)\/ script-path=https://raw.githubusercontent.com/spaoye/sb--loon/main/linuxsb_cookie.js, requires-body=false, tag=linux.sb 获取Cookie

# 每天 9:00 自动签到
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/spaoye/sb--loon/main/linuxsb_checkin.js, tag=linux.sb 定时签到

[Mitm]
hostname = linux.sb, *.linux.sb, linux.bi, *.linux.bi
